PORT=3000
# Admin panel login (change these!)
ADMIN_USER=samoli
ADMIN_PASS=samoli1122
# Telegram: create a bot with @BotFather and paste the token
TELEGRAM_BOT_TOKEN=
# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="SlotWatch <you@example.com>"

# --- Proxy settings ---
# App is behind nginx / Caddy / Cloudflare / Render etc.? Set number of proxy hops (usually 1).
# Leave empty if you run it directly (no reverse proxy).
TRUST_PROXY=
# Optional proxy for the server's own outgoing traffic (Telegram + SMTP). http:// or https:// only.
# Example: http://user:pass@proxy.example.com:8080   (leave empty for none)
OUTBOUND_PROXY=

# --- Premium system ---
# Your own numeric Telegram ID (message @userinfobot to get it) -> unlocks admin commands in the bot
ADMIN_TELEGRAM_ID=
FREE_MAX_ALERTS=2
PREMIUM_MAX_ALERTS=25
# Free users get notified this many seconds AFTER premium users (0 = same time)
FREE_DELAY_SEC=300
# Shown to users in /plan (how to buy premium, e.g. your Telegram username / bKash number)
PREMIUM_INFO="Contact @yourusername to buy Premium."
SITE_NAME=SlotWatch

# --- Online payment (UddoktaPay: bKash / Nagad / Rocket / Upay, BDT) ---
# Your UddoktaPay panel URL (no trailing slash) and API key. For testing use https://sandbox.uddoktapay.com
UDDOKTAPAY_BASE_URL=
UDDOKTAPAY_API_KEY=
# Public HTTPS address of THIS app (gateway redirects/webhooks come here)
PUBLIC_URL=
# Plans as days:price(BDT), comma separated
PLANS=30:300,90:800,180:1500
